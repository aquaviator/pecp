# PECP Control Plane Environment Variables

# Client service mode: 'MOCK' (browser-isolated deterministic fixtures) or 'API' (connect to backend)
VITE_PECP_SERVICE_MODE=MOCK

# Backend configuration (used when running API service)
PORT=3001
HOST=0.0.0.0
PECP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PECP_COOKIE_SECRET=pecp-local-cookie-secret-change-in-prod
PECP_DB_PATH=:memory:
PECP_SESSION_TTL_HOURS=12
