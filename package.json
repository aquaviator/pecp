{
  "name": "pecp-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/web run build && cp -r apps/web/dist ./dist",
    "preview": "npm --workspace=apps/web run preview",
    "lint": "npm --workspace=apps/web run lint && tsc --noEmit --project apps/api/tsconfig.json",
    "test:reference-lab": "npm --prefix reference-lab/retailco test",
    "test": "npm --workspace=apps/web run test && npm --workspace=apps/api run test && npm run test:reference-lab",
    "api:dev": "npm --workspace=apps/api run dev",
    "api:start": "npm --workspace=apps/api run start",
    "api:test": "npm --workspace=apps/api run test",
    "exec:reference": "vite-node --config apps/web/vite.config.ts scripts/run-governed-reference-execution.ts -- --mode=canonical",
    "exec:reference:smoke": "vite-node --config apps/web/vite.config.ts scripts/run-governed-reference-execution.ts -- --mode=smoke_diagnostic"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  }
}
