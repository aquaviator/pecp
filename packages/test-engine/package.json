{
  "name": "@pecp/test-engine",
  "version": "1.0.0",
  "description": "Pure deterministic engine-neutral test definition compiler and k6 bundle generator for PECP",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./execution": {
      "types": "./src/referenceExecutionHarness.ts",
      "import": "./src/referenceExecutionHarness.ts",
      "default": "./src/referenceExecutionHarness.ts"
    },
    "./results": {
      "types": "./src/resultsIngestion.ts",
      "import": "./src/resultsIngestion.ts",
      "default": "./src/resultsIngestion.ts"
    }
  },
  "dependencies": {
    "@pecp/pe-domain": "*"
  }
}
