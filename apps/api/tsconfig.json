{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@pecp/pe-domain": ["../../packages/pe-domain/src/index.ts"],
      "@pecp/platform-core": ["../../packages/platform-core/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
